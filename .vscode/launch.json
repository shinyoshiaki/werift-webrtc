  "version": "0.2.0",
  "configurations": [
    {
      "name": "node-ts",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-transform-types",
        "--disable-warning=ExperimentalWarning",
        "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
        "--import",
        "${workspaceRoot}/tools/node-ts/register.mjs"
      ],
      "program": "${workspaceRoot}/packages/ice/examples/turn_turn.ts",
      "env": {
        "DEBUG": "werift*"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "interop:client",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-transform-types",
        "--disable-warning=ExperimentalWarning",
        "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
        "--import",
        "${workspaceRoot}/tools/node-ts/register.mjs"
      ],
      "program": "${workspaceRoot}/examples/interop/client.ts",
      "env": {
        "DEBUG": "*"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "interop:client-datachannel",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-transform-types",
        "--disable-warning=ExperimentalWarning",
        "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
        "--import",
        "${workspaceRoot}/tools/node-ts/register.mjs"
      ],
      "program": "${workspaceRoot}/examples/interop/client.ts",
      "args": [
        "-t",
        "1"
      ],
      "env": {
        "DEBUG": "*"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "interop:sever",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-transform-types",
        "--disable-warning=ExperimentalWarning",
        "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
        "--import",
        "${workspaceRoot}/tools/node-ts/register.mjs"
      ],
      "program": "${workspaceRoot}/examples/interop/server.ts",
      "env": {
        "DEBUG": "werift*"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "e2e-server",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-transform-types",
        "--disable-warning=ExperimentalWarning",
