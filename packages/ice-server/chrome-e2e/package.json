{
  "name": "werift-ice-server-chrome-e2e",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "chrome": "vitest run ./tests --browser.headless --config vitest.config.mts",
    "ci": "npm run install:browsers && node run-ci.js",
    "ci:silent": "npm run install:browsers && node run-ci.js silent",
    "install:browsers": "node ensure-browser.js",
    "server": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../../tools/node-ts/register.mjs ./server/main.ts",
    "stop": "node stop.js",
    "type": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
