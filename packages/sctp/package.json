{
  "name": "werift-sctp",
  "version": "0.0.11",
  "description": "SCTP protocol implementation for Node.js written in TypeScript.",
  "homepage": "https://github.com/shinyoshiaki/werift-sctp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinyoshiaki/werift-sctp.git"
  },
  "license": "MIT",
  "author": {
    "name": "shinyoshiaki"
  },
  "main": "./lib/sctp/src/index.js",
  "types": "lib/sctp/src/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p ./tsconfig.production.json && node ../write-package-entrypoint.mjs sctp",
    "ci": "npm run type && npm run lint && npm run test",
    "client": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../tools/node-ts/register.mjs examples/client.ts",
    "deploy": "npm run build && npm publish",
    "format": "biome check --write src",
    "server": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../tools/node-ts/register.mjs examples/server.ts",
    "test": "npm run type && vitest run ./tests",
    "type": "tsc --noEmit -p . --rootDir ..",
    "upgrade-interactive": "npx npm-check-updates -i"
  },
  "dependencies": {},
  "engines": {
    "node": ">=22"
  },
  "readme": "README.md"
}
