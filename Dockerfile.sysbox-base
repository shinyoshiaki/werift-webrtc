# sak-sysbox-base ubuntu-version=24.04
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV container=sysbox
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
  && chmod a+r /etc/apt/keyrings/docker.asc \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && chmod a+r /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
  && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
  && chmod +x /usr/sbin/policy-rc.d \
  && apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl dbus dbus-user-session git gnome-keyring gnupg iproute2 iptables kmod libsecret-1-0 libsecret-tools procps sudo systemd systemd-sysv uidmap xz-utils containerd.io docker-buildx-plugin docker-ce docker-ce-cli docker-compose-plugin nodejs \
  && rm /usr/sbin/policy-rc.d \
  && systemctl enable containerd.service docker.service \
  && dbus-uuidgen --ensure=/etc/machine-id
RUN npm install -g @anthropic-ai/claude-code @github/copilot @openai/codex opencode-ai
# Playwright Chromium system libraries (ubuntu 24.04 / noble package names).
# Required for ice-server chrome-e2e, e2e/, and turn-loopback Playwright runs.
# GStreamer is required by e2e mediachannel handlers that inject test RTP
# (addTrack / red / rtx / removeTrack) via gst-launch-1.0.
# Native build toolchain (clang/llvm) and media codec dev headers are required
# by werift native addon / pipeline build targets.
RUN apt-get update \
  && apt-get install -y --no-install-recommends clang llvm lld build-essential pkg-config libssl-dev cmake make libavcodec-dev libavfilter-dev libopus-dev libvpx-dev libsrtp2-dev libasound2-dev libgstreamer1.0-0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x gstreamer1.0-alsa gstreamer1.0-pulseaudio fonts-freefont-ttf fonts-ipafont-gothic fonts-liberation fonts-noto-color-emoji fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 libdbus-1-3 libdrm2 libfontconfig1 libfreetype6 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 xfonts-cyrillic xfonts-scalable xvfb
# sak-additional-run-commands
RUN corepack enable && corepack prepare pnpm@latest --activate && pnpm --version
# sak-additional-run-commands-end
RUN apt-get clean \
  && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
  mkdir -p /usr/lib/sak; \
  if [ -x /usr/bin/git ] && [ ! -f /usr/lib/sak/real-git ]; then \
    mv /usr/bin/git /usr/lib/sak/real-git; \
  fi; \
  if [ ! -x /usr/lib/sak/real-git ]; then \
    echo "Missing real git binary for CI fix read-only wrapper installation" >&2; \
    exit 1; \
  fi; \
  printf '%s' '' | base64 -d > /usr/bin/git; \
  chmod 755 /usr/bin/git
RUN set -eux; \
  mkdir -p /usr/lib/sak; \
  printf '%s' '' | base64 -d > /usr/lib/sak/test-writable-git; \
  chmod 755 /usr/lib/sak/test-writable-git
RUN set -eux; \
  docker_socket=""; \
  if [ -S /var/run/docker.sock ]; then \
    docker_socket=/var/run/docker.sock; \
  elif [ -S /run/docker.sock ]; then \
    docker_socket=/run/docker.sock; \
  fi; \
  if ! getent group "$HOST_GID" >/dev/null; then \
    if getent group sakhost >/dev/null; then \
      groupmod -g "$HOST_GID" sakhost; \
    else \
      groupadd --gid "$HOST_GID" sakhost; \
    fi; \
  fi; \
  if ! getent passwd "$HOST_UID" >/dev/null; then \
    if id -u sak >/dev/null 2>&1; then \
      usermod -u "$HOST_UID" -g "$HOST_GID" -m sak; \
    else \
      useradd --uid "$HOST_UID" --gid "$HOST_GID" -m -s /bin/bash sak; \
    fi; \
  fi; \
  runtime_user="$(getent passwd "$HOST_UID" | cut -d: -f1 || true)"; \
  if [ -z "$runtime_user" ]; then \
    echo "Failed to resolve runtime user for HOST_UID=$HOST_UID" >&2; \
    exit 1; \
  fi; \
  docker_group="docker"; \
  if [ -n "$docker_socket" ]; then \
    docker_gid="$(stat -c '%g' "$docker_socket")"; \
    existing_docker_group="$(getent group "$docker_gid" | cut -d: -f1 || true)"; \
    if [ -n "$existing_docker_group" ]; then \
      docker_group="$existing_docker_group"; \
    elif getent group "$docker_group" >/dev/null; then \
      groupmod -g "$docker_gid" "$docker_group"; \
    else \
      groupadd --gid "$docker_gid" "$docker_group"; \
    fi; \
  elif ! getent group "$docker_group" >/dev/null; then \
    groupadd "$docker_group"; \
  fi; \
  usermod -aG "$docker_group" "$runtime_user"; \
  mkdir -p /workspace /var/lib/docker; \
  chown -R "$HOST_UID:$HOST_GID" /workspace /var/lib/docker; \
  user_home="$(getent passwd "$HOST_UID" | cut -d: -f6 || true)"; \
  if [ -n "$user_home" ] && [ -d "$user_home" ]; then \
    chown -R "$HOST_UID:$HOST_GID" "$user_home"; \
  fi; \
  if [ -n "$runtime_user" ]; then \
    runuser -u "$runtime_user" -- bash -lc 'curl -fsSL https://qwen-code-assets.oss-cn-hangzhou.aliyuncs.com/installation/install-qwen-standalone.sh | bash'; \
    ln -sf '/home/ubuntu/.local/bin/qwen' '/usr/local/bin/qwen'; \
  fi; \
  if [ -n "$runtime_user" ]; then \
    runuser -u "$runtime_user" -- bash -lc 'curl -fsSL https://cursor.com/install | bash'; \
    ln -sf '/home/ubuntu/.local/bin/cursor-agent' '/usr/local/bin/cursor-agent'; \
  fi; \
  if [ -n "$runtime_user" ]; then \
    runuser -u "$runtime_user" -- bash -lc 'true'; \
    ln -sf '/usr/local/bin/cursor-agent' '/usr/local/bin/agent'; \
  fi; \
  if [ -n "$runtime_user" ]; then \
    runuser -u "$runtime_user" -- bash -lc 'curl -fsSL https://x.ai/cli/install.sh | bash'; \
    ln -sf '/home/ubuntu/.grok/bin/grok' '/usr/local/bin/grok'; \
  fi; \
  if [ -n "$runtime_user" ]; then \
    runuser -u "$runtime_user" -- bash -lc 'curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash'; \
    ln -sf '/home/ubuntu/.kimi-code/bin/kimi' '/usr/local/bin/kimi'; \
  fi;
WORKDIR /workspace
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
