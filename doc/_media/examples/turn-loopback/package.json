{
  "name": "werift-example-turn-loopback",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run type && vite build",
    "client": "vite",
    "chrome-e2e": "cd chrome-e2e && npm i && npm run ci:silent",
    "chrome-e2e:verbose": "cd chrome-e2e && npm i && npm run ci",
    "docker:build": ". ./.env && cd ../.. && docker build -f examples/turn-loopback/Dockerfile -t $IMAGE_TAG .",
    "preview": "vite preview",
    "server": "tsx --tsconfig tsconfig.server.json server/main.ts",
    "type": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
